    shrink: 1.0
    tsv: false
    thickness: 20.0
    offset: [0.0, 0.0]
    regions:
      front:
        side: front
        coords: [[0.0, 0.0], [400.0, 0.0], [400.0, 200.0], [0.0, 200.0]]
        bmap: bmaps/muyan.bmap
        layer: metal1
