Header:
  version: "3.0"
  unit: micron
  precision: 1000

ChipletDef:
  PRTOOL_INTERPOSER:
    type: rdl
    design_area: [7300.0, 5500.0]
    shrink: 1.0
    tsv: false
    thickness: 50.0
    offset: [0.0, 0.0]
    regions:
      front:
        side: front
        coords: [[0.0, 0.0], [7300.0, 0.0], [7300.0, 5500.0], [0.0, 5500.0]]
